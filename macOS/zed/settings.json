// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "restore_on_startup": "launchpad",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "tabs": {
    "close_position": "left",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true
  },
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "buffer_line_height": "comfortable",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "cursor_shape": "bar",
  "cursor_animation": {
    "enabled": true
  },
  "icon_theme": "Monospace Icon Theme - Dark",
  "terminal": {
    "font_size": 12.0,
    "font_family": "Geist Mono"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent": {
    "dock": "bottom",
    "enabled": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "minimap": {
    "show": "always"
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "Geist Mono",
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Monospace light",
    "dark": "Monospace dark",
  },
}
